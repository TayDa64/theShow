# Everything here is optional for the plugin. The MCP server needs none of it.
# These configure theShow Studio only.
# The server calls dotenv.config() and reads this file as .env.
# A .env.local next to it is ignored. Copy this file to .env.

# THESHOW_VIDEO_BACKEND: pin the renderer.
#   grok     Grok credential (XAI_API_KEY, else the Grok CLI session)
#   gemini   Gemini path. Needs GEMINI_API_KEY or a key connected in Account
#   sandbox  Mock preview. No paid call. Use this for tests.
# Unset is not a quiet fallback. With no pin, no Grok credential, and no Gemini
# key, a live render returns HTTP 503 no-video-backend.
# THESHOW_VIDEO_BACKEND=sandbox

# THESHOW_STUDIO_FEED: set to 0 to disable GET /api/production/feed (404).
# The route is loopback-only and never writes ~/.theshow.
# THESHOW_STUDIO_FEED=

# PORT: Studio listen port. Default 3000. Playwright uses 3100 and 3101.
# PORT=3000

# GEMINI_API_KEY: used when the resolved backend is gemini.
GEMINI_API_KEY=""

# APP_URL: the URL the Studio is served from. Used for self-referential links
# and OAuth callbacks.
APP_URL="MY_APP_URL"

# SESSION_SECRET: signs sessions. Required in production.
SESSION_SECRET=""

# STORYFORGE_ENCRYPTION_KEY: env var name is unchanged. Encrypts per-account
# provider keys at rest.
STORYFORGE_ENCRYPTION_KEY=""

# Google sign-in. Leave all three unset to disable it and use password login.
GOOGLE_OIDC_CLIENT_ID=""
GOOGLE_OIDC_CLIENT_SECRET=""
GOOGLE_OIDC_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
