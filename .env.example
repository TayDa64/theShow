# Everything here is optional for the plugin. The MCP server needs none of it.
# These configure the StoryForge Studio web app only.

# GEMINI_API_KEY: the Veo fallback path, used when no Grok credential resolves.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: the URL the Studio is served from. Used for self-referential links
# and OAuth callbacks.
APP_URL="MY_APP_URL"

# SESSION_SECRET: signs sessions. Required in production.
SESSION_SECRET=""

# STORYFORGE_ENCRYPTION_KEY: encrypts per-account provider keys at rest.
STORYFORGE_ENCRYPTION_KEY=""

# Google sign-in. Leave all three unset to disable it and use password login.
GOOGLE_OIDC_CLIENT_ID=""
GOOGLE_OIDC_CLIENT_SECRET=""
GOOGLE_OIDC_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
